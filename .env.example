# Copie este arquivo para .env.local (não commitado) e preencha os valores reais.

# Chave da API do Resend (resend.com) — usada para enviar o e-mail de
# notificação de novos leads. Sem ela, o lead ainda é registrado no log
# do servidor, mas nenhum e-mail é disparado. Ver README para o passo a passo.
RESEND_API_KEY=

# URL pública do site (usada em metadata, sitemap.xml e robots.txt).
NEXT_PUBLIC_SITE_URL=
